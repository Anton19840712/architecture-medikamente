  <diagram id="c4-context-mvp" name="C4 Context — Целевое состояние MVP">
    <mxGraphModel dx="1620" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" math="0" shadow="0">
      <root>
