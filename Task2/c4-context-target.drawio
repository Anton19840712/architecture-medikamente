        <!-- Title -->
        <mxCell id="title" value="C4 Context Diagram — Медикаменте (Целевое состояние, MVP)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="900" height="40" as="geometry"/>
        </mxCell>

        <!-- =================== PERSONS =================== -->

        <!-- Пациент -->
        <mxCell id="p_patient" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Клиент медицинского центра.&lt;br&gt;Записывается на приём,&lt;br&gt;просматривает свои данные." style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="160" height="170" as="geometry"/>
        </mxCell>

        <!-- Сотрудник ресепшена -->
        <mxCell id="p_reception" value="&lt;b&gt;Сотрудник ресепшена&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Управляет записями&lt;br&gt;пациентов, видит&lt;br&gt;расписание." style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="680" width="160" height="170" as="geometry"/>
        </mxCell>

        <!-- Врач -->
        <mxCell id="p_doctor" value="&lt;b&gt;Врач&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Ведёт приём,&lt;br&gt;вносит результаты&lt;br&gt;осмотра и назначения." style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="160" height="170" as="geometry"/>
        </mxCell>

        <!-- Кассир / Бухгалтер -->
        <mxCell id="p_cashier" value="&lt;b&gt;Кассир / Бухгалтер&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Проводит платежи,&lt;br&gt;ведёт финансовый учёт." style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="940" width="160" height="170" as="geometry"/>
        </mxCell>

        <!-- Администратор ИТ -->
        <mxCell id="p_admin" value="&lt;b&gt;ИТ-администратор&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Управляет инфраструктурой,&lt;br&gt;доступом, мониторингом." style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="1680" y="420" width="160" height="170" as="geometry"/>
        </mxCell>

