        <!-- =================== SOFTWARE SYSTEMS (internal) =================== -->

        <!-- Клиентский портал / мобильное приложение -->
        <mxCell id="s_portal" value="&lt;b&gt;Клиентский портал&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Личный кабинет пациента.&lt;br&gt;Запись на приём, просмотр&lt;br&gt;своих данных, уведомления." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="380" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- Портал сотрудников -->
        <mxCell id="s_staff" value="&lt;b&gt;Портал сотрудника&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Рабочее место ресепшена,&lt;br&gt;врача, кассира.&lt;br&gt;Расписание, медкарты, платежи." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="640" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- API Gateway + WAF -->
        <mxCell id="s_gateway" value="&lt;b&gt;API Gateway + WAF&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Единая точка входа.&lt;br&gt;Rate limiting, WAF,&lt;br&gt;авторизация контрактов." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="500" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- IAM -->
        <mxCell id="s_iam" value="&lt;b&gt;IAM / OIDC&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Аутентификация, MFA,&lt;br&gt;RBAC/ABAC, выдача токенов.&lt;br&gt;&lt;i&gt;(Privacy by Design)&lt;/i&gt;" style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- CRM / Scheduling -->
        <mxCell id="s_crm" value="&lt;b&gt;CRM / Scheduling&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Управление записями,&lt;br&gt;расписанием, журналом приёма,&lt;br&gt;контрактами." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="300" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- EMR -->
        <mxCell id="s_emr" value="&lt;b&gt;EMR (Медицинские записи)&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Хранение и обработка PHI:&lt;br&gt;диагнозы, назначения,&lt;br&gt;результаты анализов." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="540" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- Payment Gateway -->
        <mxCell id="s_pay" value="&lt;b&gt;Payment Gateway&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Платёжный шлюз.&lt;br&gt;Токенизация, расчёты,&lt;br&gt;интеграция с ККМ и 1С." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="780" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- Consent & Privacy Service -->
        <mxCell id="s_consent" value="&lt;b&gt;Consent &amp; Privacy Service&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Хранение согласий (152-ФЗ ст. 9),&lt;br&gt;отзыв согласий, удаление ПДн&lt;br&gt;по запросу (ст. 17, 21).&lt;br&gt;&lt;i&gt;(Privacy by Design)&lt;/i&gt;" style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="1200" y="200" width="200" height="200" as="geometry"/>
        </mxCell>

        <!-- Metadata / Tag Catalog -->
        <mxCell id="s_catalog" value="&lt;b&gt;Metadata &amp; Tag Catalog&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Классификация данных,&lt;br&gt;lineage, теги PII/PHI/FINANCE.&lt;br&gt;&lt;i&gt;(Privacy by Design)&lt;/i&gt;" style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;align=center;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="1200" y="460" width="200" height="200" as="geometry"/>
