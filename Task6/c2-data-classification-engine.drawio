          <mxGeometry x="400" y="20" width="1200" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== EXTERNAL SYSTEMS ========== -->

        <!-- Source systems -->
        <mxCell id="src_crm" value="&lt;b&gt;CRM / Scheduling&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Записи пациентов, расписание.&lt;br&gt;Источник PII-данных." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#7a7a7a;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="180" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="src_emr" value="&lt;b&gt;EMR&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Медицинские карты, анализы.&lt;br&gt;Источник PHI-данных." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#7a7a7a;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="180" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="src_1c" value="&lt;b&gt;1С / ERP&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Платежи, бухгалтерия, склад.&lt;br&gt;Источник FINANCE-данных." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#7a7a7a;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="180" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="src_files" value="&lt;b&gt;Legacy File Storage&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Excel, PDF, JPG на диске.&lt;br&gt;Неразмеченные исходные файлы." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#7a7a7a;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="180" height="160" as="geometry"/>
        </mxCell>

        <!-- DWH / downstream -->
        <mxCell id="dst_dwh" value="&lt;b&gt;DWH / Data Lakehouse&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Аналитическое хранилище.&lt;br&gt;Принимает только обработанные,&lt;br&gt;помеченные данные." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#7a7a7a;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1760" y="480" width="180" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="dst_audit" value="&lt;b&gt;Audit / SIEM&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Журналирование всех решений&lt;br&gt;движка, аномалии, алертинг." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#7a7a7a;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1760" y="720" width="180" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="dst_catalog" value="&lt;b&gt;Metadata Catalog&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;Apache Atlas / OpenMetadata.&lt;br&gt;Теги, lineage, версии схем." style="shape=mxgraph.c4.system2;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#7a7a7a;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1760" y="240" width="180" height="160" as="geometry"/>
        </mxCell>

        <!-- ========== SYSTEM BOUNDARY: Data Classification Engine ========== -->
        <mxCell id="boundary" value="Data Classification Engine [System Boundary]" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];shape=mxgraph.c4.system_boundary;whiteSpace=wrap;html=1;strokeColor=#444444;fillColor=none;fontStyle=1;fontSize=13;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="1370" height="1000" as="geometry"/>
        </mxCell>

        <!-- ========== CONTAINERS ========== -->

        <!-- 1. Ingestion / Landing Zone -->
        <mxCell id="c_ingest" value="&lt;b&gt;Ingestion / Landing Zone&lt;/b&gt;&lt;br&gt;[Container: Message Queue / Storage]&lt;br&gt;&lt;br&gt;Принимает пакеты данных от источников.&lt;br&gt;Краткосрочное хранение (TTL).&lt;br&gt;Kafka / S3 Raw." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="440" width="210" height="180" as="geometry"/>
        </mxCell>

        <!-- 2. Schema Registry -->
        <mxCell id="c_schema" value="&lt;b&gt;Schema Registry&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;&lt;br&gt;Отслеживает версии структур данных.&lt;br&gt;Обнаруживает структурные изменения.&lt;br&gt;Confluent Schema Registry / Apicurio." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="700" width="210" height="180" as="geometry"/>
        </mxCell>

        <!-- 3. Data Profiler -->
        <mxCell id="c_profiler" value="&lt;b&gt;Data Profiler&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;&lt;br&gt;Вычисляет: null-rate, cardinality,&lt;br&gt;regex match, распределения значений.&lt;br&gt;Apache Spark / Great Expectations." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="280" width="210" height="180" as="geometry"/>
        </mxCell>

        <!-- 4. Classification Engine -->
        <mxCell id="c_classifier" value="&lt;b&gt;Classification Engine&lt;/b&gt;&lt;br&gt;[Container: Service — Core]&lt;br&gt;&lt;br&gt;Определяет класс поля: PII/PHI/FINANCE.&lt;br&gt;Объединяет сигналы Rules Engine + ML.&lt;br&gt;Python / Java сервис." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="530" width="210" height="190" as="geometry"/>
        </mxCell>

        <!-- 5. Rules Engine -->
        <mxCell id="c_rules" value="&lt;b&gt;Rules Engine&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;&lt;br&gt;Политики по тегам и Privacy.&lt;br&gt;Regex / словари / контекстные правила.&lt;br&gt;Drools / custom DSL." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="790" width="210" height="180" as="geometry"/>
        </mxCell>

        <!-- 6. ML/NLP Detector -->
        <mxCell id="c_ml" value="&lt;b&gt;ML / NLP Detector&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;&lt;br&gt;Распознаёт новые / нестандартные поля.&lt;br&gt;NER-модели (SpaCy / Presidio).&lt;br&gt;Обновляется через CI/CD." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="280" width="210" height="180" as="geometry"/>
        </mxCell>

        <!-- 7. Policy Decision Point -->
        <mxCell id="c_pdp" value="&lt;b&gt;Policy Decision Point&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;&lt;br&gt;Решает: загрузить / маскировать /&lt;br&gt;обезличить / карантин.&lt;br&gt;OPA / custom policy engine." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="530" width="210" height="190" as="geometry"/>
        </mxCell>

        <!-- 8. Masking / Tokenization -->
        <mxCell id="c_mask" value="&lt;b&gt;Masking / Tokenization /&lt;br&gt;Pseudonymization&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;&lt;br&gt;Применяет трансформации к данным.&lt;br&gt;ARX / custom + Vault Transit." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="280" width="210" height="200" as="geometry"/>
        </mxCell>

        <!-- 9. Quarantine Zone -->
        <mxCell id="c_quarantine" value="&lt;b&gt;Quarantine Zone&lt;/b&gt;&lt;br&gt;[Container: Storage]&lt;br&gt;&lt;br&gt;Задержанные наборы, требующие&lt;br&gt;ручного разбора.&lt;br&gt;S3 / restricted bucket." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="560" width="210" height="180" as="geometry"/>
        </mxCell>

        <!-- 10. Curated Secure Zone -->
        <mxCell id="c_curated" value="&lt;b&gt;Curated Secure Zone&lt;/b&gt;&lt;br&gt;[Container: Storage]&lt;br&gt;&lt;br&gt;Обработанные наборы для BI.&lt;br&gt;Контролируемый доступ, теги,&lt;br&gt;шифрование at rest (AES-256)." style="shape=mxgraph.c4.component2;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA8;fontColor=#ffffff;labelBackgroundColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="820" width="210" height="190" as="geometry"/>
